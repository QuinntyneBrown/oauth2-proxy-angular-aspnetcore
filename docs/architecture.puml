@startuml architecture
title Architecture: Kubernetes + oauth2-proxy + Okta

skinparam shadowing false
left to right direction

actor "Browser\n(Angular SPA)" as B
rectangle "Kubernetes cluster" as K8s #F7F7F7 {
    rectangle "Ingress" as I
    rectangle "oauth2-proxy\nDeployment/Service" as P
    rectangle "Angular assets\nnginx Deployment/Service\nincl. /assets/whoami.txt" as S
    rectangle "ASP.NET Core API\nDeployment/Service" as A
}
cloud "Okta\n(OIDC provider)" as O

B --> I : session cookie only
I --> P
P --> S : static assets
P --> A : Authorization: Bearer <id-token>
P <..> O : OIDC authorization-code flow

@enduml
